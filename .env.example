# =============================================================================
# CMO Simulator — environment variables
# Copy this file to .env.local and fill in the values for your project.
# Never commit .env.local to version control.
# =============================================================================

# Required — Supabase project URL and anon key (both are browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required — used for absolute URL generation and auth redirects locally
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional — server-only service role key for admin operations
# Do NOT prefix with NEXT_PUBLIC_ — this must never be exposed to the browser.
# After the Phase 2 persistence refactor this key is NOT required for normal
# user saves; it is only needed for future admin/server-side admin tooling.
# SUPABASE_SERVICE_ROLE_KEY=
